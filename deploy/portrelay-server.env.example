# 复制为 /etc/portrelay-server.env 并设为 0600：
#   sudo install -m 600 deploy/portrelay-server.env.example /etc/portrelay-server.env
#
# Agent 与网关之间的共享密钥（必填）。生成方式：openssl rand -hex 24
PORTRELAY_TOKEN=change-me-to-a-long-random-string

# 额外的启动参数（可选），例如：
#   -public-host gw.example.com   授权页上展示给访问者的地址（默认取访问者打开链接时用的地址）
#   -trust-proxy                  网关前面有可信反向代理时才开启
PORTRELAY_ARGS=
